# --- Gemini ---------------------------------------------------------------
# Server-only. Never prefix this with NEXT_PUBLIC_.
# Without a key the deterministic edge model answers instead.
GEMINI_API_KEY=
# Optional override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# --- Public site metadata -------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase (optional) --------------------------------------------------
# Leave these blank to run the local-first demo store. Enable Anonymous Auth
# and Firestore in the Firebase console before filling them in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
